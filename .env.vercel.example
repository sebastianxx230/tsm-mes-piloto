# Inventario para Vercel Production. No subir valores reales a GitHub.
FLASK_APP=app.py
FLASK_DEBUG=False
APP_ENV=production
SECRET_KEY=GENERATE_A_NEW_RANDOM_SECRET
DATABASE_URL=NEON_POOLED_RUNTIME_URL

SESSION_COOKIE_SECURE=True
SESSION_LIFETIME_HOURS=10
WTF_CSRF_SSL_STRICT=True
TRUST_PROXY_HOPS=1
MAX_CONTENT_MB=4

# Antes de abrir el piloto, use una URL Redis compartida real.
# RATELIMIT_STORAGE_URI=redis://default:password@host:6379/0
LOGIN_RATE_LIMIT=5 per minute
REPORT_RATE_LIMIT=3 per minute
REQUIRE_IMPORT_VERSION=True
REQUIRE_COMPONENT_VERSION=True

GOOGLE_CREDENTIALS=GOOGLE_SERVICE_ACCOUNT_JSON_ONE_LINE
DRIVE_PARENT_FOLDER_ID=DRIVE_FOLDER_ID
DRIVE_PARENT_FOLDER_ID_2025=DRIVE_2025_FOLDER_ID
DRIVE_PARENT_FOLDER_ID_2026=DRIVE_2026_FOLDER_ID
# DRIVE_PLANOS_FOLDER_NAME=PLANOS_PRODUCCION
# DRIVE_OTROS_DOCUMENTOS_FOLDER_NAME=OTROS_DOCUMENTOS

MAX_IMPORT_COMPONENTS=5000
MAX_MESSAGE_LENGTH=2000
MAX_TRACKING_PHOTOS=12
MAX_TRACKING_DOCUMENT_BYTES=4194304

# Perfil limitado para respetar el maximo de 4.5 MB por request/response.
MAX_REPORT_IMAGES=6
MAX_REPORT_LOCAL_IMAGES=1
MAX_REPORT_IMAGE_BYTES=3145728
MAX_REPORT_TOTAL_BYTES=12582912
MAX_REPORT_LOCAL_TOTAL_BYTES=3145728
MAX_REPORT_IMAGE_PIXELS=16000000
MAX_REPORT_TEXT_LENGTH=500
REPORT_WORKERS=2
REPORT_OUTPUT_MAX_WIDTH=640
REPORT_OUTPUT_JPEG_QUALITY=70
MAX_REPORT_RENDERED_IMAGE_BYTES=389120
MAX_REPORT_RENDERED_TOTAL_BYTES=2457600
DRIVE_HTTP_TIMEOUT_SECONDS=25
ALLOW_PARTIAL_DRIVE_FOLDER_MATCH=False
PHOTO_COUNT_CACHE_TTL=300
PHOTO_COUNT_CACHE_MAX_ITEMS=500
LOG_LEVEL=INFO
