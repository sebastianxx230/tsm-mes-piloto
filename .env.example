# Plantilla general. Copie a .env solo para desarrollo local.
# Para Vercel use .env.vercel.example como inventario del dashboard.
# Para Docker copie .env.container.example a .env.container.
FLASK_APP=app.py
FLASK_DEBUG=True
APP_ENV=development
SECRET_KEY=generate-a-new-random-value-of-at-least-32-bytes

# Aplicacion: URL pooled de Neon (hostname terminado en -pooler).
DATABASE_URL=postgresql://app_user:password@host-pooler:5432/neondb?sslmode=require
# Solo migraciones/pg_dump: URL directa del propietario. Nunca subir a Vercel.
MIGRATIONS_DATABASE_URL=postgresql://owner:password@host:5432/neondb?sslmode=require

SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=10
WTF_CSRF_SSL_STRICT=False
TRUST_PROXY_HOPS=0
MAX_CONTENT_MB=50
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CHECK_DATABASE_ON_STARTUP=False

# memory:// es valido solo para desarrollo o un contenedor unico.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=5 per minute
REPORT_RATE_LIMIT=3 per minute
REQUIRE_IMPORT_VERSION=True
REQUIRE_COMPONENT_VERSION=True

GOOGLE_CREDENTIALS={"type":"service_account","project_id":"replace-me"}
DRIVE_PARENT_FOLDER_ID=replace-me
DRIVE_PARENT_FOLDER_ID_2025=replace-me
DRIVE_PARENT_FOLDER_ID_2026=replace-me
# Estructura 2026: OT_2026-00XX/{DOCUMENTOS,FOTOGRAFIAS,PLANOS}
# DRIVE_PLANOS_FOLDER_NAME=PLANOS
# DRIVE_OTROS_DOCUMENTOS_FOLDER_NAME=DOCUMENTOS
MAX_TRACKING_PHOTO_UPLOAD_BYTES=3145728
MAX_TRACKING_DOCUMENT_UPLOAD_BYTES=3145728

MAX_IMPORT_COMPONENTS=5000
MAX_MESSAGE_LENGTH=2000
MAX_TRACKING_PHOTOS=12
MAX_TRACKING_DOCUMENT_BYTES=52428800
MAX_REPORT_IMAGES=20
MAX_REPORT_LOCAL_IMAGES=4
MAX_REPORT_IMAGE_BYTES=6291456
MAX_REPORT_TOTAL_BYTES=33554432
MAX_REPORT_LOCAL_TOTAL_BYTES=8388608
MAX_REPORT_IMAGE_PIXELS=25000000
MAX_REPORT_TEXT_LENGTH=500
REPORT_WORKERS=3
ALLOW_PARTIAL_DRIVE_FOLDER_MATCH=False
PHOTO_COUNT_CACHE_TTL=300
PHOTO_COUNT_CACHE_MAX_ITEMS=500
LOG_LEVEL=INFO
