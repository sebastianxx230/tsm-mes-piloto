FLASK_APP=app.py
FLASK_DEBUG=False
APP_ENV=production
SECRET_KEY=replace-with-a-random-value-of-at-least-32-bytes
# Runtime: Neon pooled URL (hostname ending in -pooler).
DATABASE_URL=postgresql://user:password@host-pooler:5432/tsm?sslmode=require
# Migrations and pg_dump: direct Neon URL.
MIGRATIONS_DATABASE_URL=postgresql://user:password@host:5432/tsm?sslmode=require
SESSION_COOKIE_SECURE=True
SESSION_LIFETIME_HOURS=10
WTF_CSRF_SSL_STRICT=True
TRUST_PROXY_HOPS=1
MAX_CONTENT_MB=50
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Use memory:// only for one container. Vercel/multi-instance must use Redis.
RATELIMIT_STORAGE_URI=redis://default:password@host:6379/0
LOGIN_RATE_LIMIT=5 per minute
REQUIRE_IMPORT_VERSION=True
REQUIRE_COMPONENT_VERSION=True

GOOGLE_CREDENTIALS={"type":"service_account","project_id":"replace-me"}
DRIVE_PARENT_FOLDER_ID=replace-me
DRIVE_PARENT_FOLDER_ID_2025=replace-me
DRIVE_PARENT_FOLDER_ID_2026=replace-me

MAX_REPORT_IMAGES=30
MAX_REPORT_IMAGE_BYTES=6291456
MAX_REPORT_IMAGE_PIXELS=25000000
MAX_REPORT_TEXT_LENGTH=500
MAX_TRACKING_PHOTOS=12
PHOTO_COUNT_CACHE_TTL=300
PHOTO_COUNT_CACHE_MAX_ITEMS=500
LOG_LEVEL=INFO
